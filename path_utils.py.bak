# -*- coding: utf-8 -*-
"""
Safe path management for PyInstaller bundled applications.

Bundled resources and writable application data are intentionally separate:
resources are read from PyInstaller's temporary bundle when frozen, while
database, reports, backups and exports live in a single writable data folder.
"""
import sys
import os
from pathlib import Path


DB_FILE_NAME = "manager.db"
AUTH_DB_FILE_NAME = "matadors_kasa_auth.db"


def get_app_root():
    """Return the directory that owns the running app/exe."""
    if getattr(sys, "frozen", False):
        exe_dir = Path(sys.executable).resolve().parent
        if exe_dir.name.lower() == "dist":
            parent = exe_dir.parent
            if (parent / "MatadorsApp_Data").exists() or (parent / "matadors_kasa.spec").exists():
                return str(parent)
        return str(exe_dir)
    return os.path.dirname(os.path.abspath(__file__))

def resource_path(relative_path):
    """
    Get absolute path to resource, works for dev and for PyInstaller
    
    Args:
        relative_path (str): Relative path to the resource
        
    Returns:
        str: Absolute path to the resource
    """
    try:
        # PyInstaller creates a temp folder and stores path in _MEIPASS
        base_path = sys._MEIPASS
    except Exception:
        base_path = get_app_root()
    
    return os.path.join(base_path, relative_path)

def get_customtkinter_assets_path():
    """
    Get the path to customtkinter assets directory
    
    Returns:
        str: Path to customtkinter assets directory
    """
    return resource_path("customtkinter/assets")

def get_app_assets_path():
    """
    Get the path to application assets directory
    
    Returns:
        str: Path to application assets directory
    """
    return resource_path("assets")

def ensure_path_exists(path):
    """
    Ensure a directory exists, create if it doesn't
    
    Args:
        path (str): Directory path to ensure exists
    """
    os.makedirs(path, exist_ok=True)
    return path


def get_data_dir():
    """Return the writable data root requested by the app layout."""
    return ensure_path_exists(os.path.join(get_app_root(), "MatadorsApp_Data"))


def get_local_dir():
    """Return the local SQLite profile directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "local"))


def get_drive_sync_dir():
    """Return the default local Google Drive sync mirror directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "drive_sync"))


def get_kasalar_dir():
    """Return the per-cashier JSON data directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "kasalar"))


def get_reports_dir():
    """Return the single reports directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "reports"))


def get_backups_dir():
    """Return the single backups directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "backups"))


def get_logs_dir():
    """Return the single logs directory."""
    return ensure_path_exists(os.path.join(get_data_dir(), "logs"))


def get_exports_dir():
    """Compatibility alias; exports are kept under reports in the standard layout."""
    return get_reports_dir()


def ensure_standard_data_dirs():
    """Create the one supported writable layout."""
    for path in (get_local_dir(), get_drive_sync_dir(), get_kasalar_dir(), get_backups_dir(), get_reports_dir(), get_logs_dir()):
        ensure_path_exists(path)


def get_db_path():
    return os.path.join(get_local_dir(), DB_FILE_NAME)


def get_auth_db_path():
    return os.path.join(get_local_dir(), AUTH_DB_FILE_NAME)
